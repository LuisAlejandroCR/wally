# Cerrojo — nombres de variables. NUNCA se commitean valores reales.
# Copia a .env y rellena. La seed es de TESTNET y nunca sale de la maquina.

CERROJO_SEED=                 # 12 palabras BIP-39 de TESTNET. Nunca se imprime.
CERROJO_NETWORK=sepolia
CERROJO_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Token de la nomina (USDT de Sepolia del registro de WDK)
CERROJO_TOKEN_SYMBOL=USDT
CERROJO_TOKEN_ADDRESS=0xd077A400968890Eacc75cdc901F0356c943e4fDb
CERROJO_TOKEN_DECIMALS=6

# Topes, en unidades base enteras (6 decimales => 500000000 = 500 USDT)
CERROJO_CAP_TX=500000000
CERROJO_CAP_DAY=1500000000
CERROJO_ALLOWLIST=./evals/fixtures/allowlist.txt

# CSV de nomina que usa `cerrojo run` cuando no se pasa --csv
CERROJO_CSV=./evals/fixtures/nomina_agosto.csv

# Demo de mainnet: SOLO LECTURA. Ponerlo en false es un bug de bloqueo.
CERROJO_DEMO_NETWORK=polygon
CERROJO_DEMO_RPC_URL=https://polygon-bor-rpc.publicnode.com
CERROJO_DEMO_READONLY=true

# Planner
CERROJO_PLANNER=rules         # rules | llm
CERROJO_PLANNER_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Eval
CERROJO_EVAL_RUNS=5

# Salidas en disco: recibos de cada corrida y ledger diario del acumulado
CERROJO_RUNS_DIR=./runs
CERROJO_STATE_DIR=./state

# API HTTP de `cerrojo serve`. Las banderas --puerto y --host mandan sobre estas.
CERROJO_API_PORT=8787
# Por defecto 127.0.0.1. Con 0.0.0.0 la API queda expuesta a la red local:
# solo vale la pena en una red de confianza.
CERROJO_API_HOST=127.0.0.1
