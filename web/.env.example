# Cerrojo web — variable names only. Never commit real values.

# Clerk. Written by `clerk init --app <app-id>`; also available in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional. A reachable Cerrojo HTTP API (`node src/cli.js serve` behind a tunnel).
# Unset: the site serves the recorded receipts that ship in src/data/ — the default.
# Set:   the Policies page reads live, and a signed-in operator can run a payroll.
# Server-side on purpose: the browser never learns where the engine lives.
CERROJO_API_URL=
